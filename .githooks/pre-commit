#!/usr/bin/env bash
# .githooks/pre-commit — Odysseus meta-repo commit-time guardrails.
#
# `tools/propagate-pre-commit-hooks.sh` copies this standalone guard into the
# default hook directories of initialized submodules. Root developer setup
# installs `.pre-commit-config.yaml` through `scripts/install/dev/80-precommit.sh`;
# this repository does not expose a `just install-hooks` recipe.
# This hook is the last-mile layer on top of:
#   - the stdin-preserving signed-commit check in .githooks/pre-push
#   - the banned-paths list in .gitignore
#   - the secret-handling rule under "Protected boundaries" in AGENTS.md
#
# Scope of THIS hook: refuse to commit a staged file that matches a banned
# credential / secret / private-key / large-file pattern. The hook fails
# loudly with a remediation hint, never silently bypasses.
#
# Per AGENTS.md, repository hooks must not be bypassed. If this hook fails,
# fix the staged set: `git restore --staged <path>`, edit the file, or
# `git rm --cached <path>` to untrack a tracked file.
#
# Exit code: 0 on clean, 1 on any banned path detected.

set -euo pipefail

# Detect staged files. The `if !` wrapper fails loud on a real `git diff`
# failure (no PATH, corrupt index, partial clone, etc.) — we cannot
# enumerate what is about to be committed, so the only safe response to
# "we don't know" is to fail loud, not to silently let the commit through.
#
# CRITICAL: we deliberately do NOT use `-z` here. Bash command substitution
# `$(...)` strips NUL bytes from the captured output, so `staged` would
# become a path-concatenated blob with no separators — and the downstream
# `read -d ''` would silently EOF without ever iterating the loop body.
# The newline-separated form lets `[ -z "$staged" ]` reliably detect an
# empty index (no staged files). The NUL-delimited stream is re-fetched
# via process substitution at the loop site so `read -d ''` can split
# paths correctly (preserving spaces, tabs, and newlines in filenames).
#
# Note: 'git diff' is invoked TWICE per commit because of the NUL-stripping
# limitation above. Once here (newline-separated, safe for $()), and once
# below into a temp file (NUL-delimited, safe for `read -d ''`). The
# duplication is intentional.
if ! staged=$(git diff --cached --name-only --diff-filter=ACMRT); then
    echo "ERROR: 'git diff --cached --name-only' failed; refusing to commit unverified." >&2
    echo "       Resolve the Git/index failure and retry; do not bypass repository hooks." >&2
    exit 1
fi

# Empty-staged guard. New commits, merges of unrelated branches, and
# `git commit --allow-empty` all leave no files in the index. Nothing
# to check; exit 0 so the commit proceeds.
if [ -z "${staged:-}" ]; then
    exit 0
fi

# Defense-in-depth: capture the second `git diff` output to a temp file so
# we can (a) check its exit code (the first invocation is already gated
# by `if !` above) and (b) feed the loop from a NUL-preserving source. A
# transient `git diff` failure during the loop would otherwise EOF
# `read -d ''` immediately and silently bypass every check below.
#
# `mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX"` creates a unique file in
# $TMPDIR (or /tmp on systems without TMPDIR) with mode 0600 (no leakage
# to other users). Using the POSIX template form — NO `-t` flag — keeps
# the hook portable across GNU coreutils, BSD/macOS, and BusyBox mktemp.
# The `-t` flag was deprecated in GNU coreutils 8.32 (2020) and now emits
# a deprecation warning to stderr on every invocation, regardless of
# the caller's shell options; on hardened systems it is rejected outright.
# The template-form prefix used here is universally supported.
#
# The EXIT trap fires on every exit path: clean, `set -e`, explicit
# `exit 1`, and normal EOF. It preserves the incoming status. It also makes a
# cleanup failure fatal after a successful inspection. SIGKILL and SIGQUIT
# cannot be caught by bash, so a `kill -9` mid-flight WILL leak the file;
# mktemp's 0600 mode ensures any stranded file is unreadable to other
# users. The only impact is one small file in /tmp. This is a best-effort
# mitigation, not a hard guarantee.
temp_diff=$(mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX")

cleanup_temp_diff() {
    cleanup_status=$1
    trap - EXIT
    if ! rm -f -- "$temp_diff"; then
        echo "ERROR: failed to remove pre-commit temporary file: $temp_diff" >&2
        if [ "$cleanup_status" -eq 0 ]; then
            cleanup_status=1
        fi
    fi
    exit "$cleanup_status"
}
trap 'cleanup_temp_diff "$?"' EXIT

if ! git diff --cached --name-only -z --diff-filter=ACMRT > "$temp_diff"; then
    echo "ERROR: 'git diff --cached --name-only -z' failed during loop setup; aborting." >&2
    exit 1
fi

# Banned patterns. Each pattern is anchored to a path segment or a secret-file
# suffix. Permit the tracked `.env.example` template, but reject every other
# `.env` variant. A `secrets/` path remains banned, including a template in it.
banned='(^|/)(secrets/|id_rsa$|id_ed25519$|credentials\.json$|service-account[^/]*\.json$)|\.(pem|key|p12|pfx|gpg)$'
banned_env='(^|/)\.env($|\.[^/]+$)'

# Large-file guard: 512 KiB. This native local hook owns the threshold; no
# pre-commit-framework or CI parity is claimed.
max_bytes=$((512 * 1024))

bad_paths=()
big_files=()
index_failures=()
# Iterate via -z (NUL-separated) and read with -d '' so paths containing
# spaces, tabs, or newlines are preserved. Avoids `for f in $staged` which
# would word-split on $IFS and break on whitespace in paths.
while IFS= read -r -d '' f; do
    is_banned=0
    if printf '%s\n' "$f" | grep -Eq "$banned"; then
        is_banned=1
    elif [ "${f##*/}" != ".env.example" ] && \
        printf '%s\n' "$f" | grep -Eq "$banned_env"; then
        is_banned=1
    fi
    if [ "$is_banned" -eq 1 ]; then
        bad_paths+=("$f")
    fi
    index_type=""
    if ! index_type=$(git cat-file -t ":./$f" 2>/dev/null); then
        index_failures+=("$f (staged object type unavailable)")
        continue
    fi
    # Index entries for ordinary files and symlinks are blobs. A staged
    # gitlink is a commit object and has no repository-owned file payload to
    # size here.
    if [ "$index_type" = "blob" ]; then
        size=""
        if ! size=$(git cat-file -s ":./$f" 2>/dev/null); then
            index_failures+=("$f (staged blob size unavailable)")
        elif [ "$size" -gt "$max_bytes" ]; then
            big_files+=("$f (${size} bytes)")
        fi
    fi
done < "$temp_diff"

if [ "${index_failures[0]+present}" = "present" ]; then
    echo "ERROR: Could not inspect staged Git object(s); commit aborted." >&2
    for p in "${index_failures[@]}"; do
        printf '  - %s\n' "$p" >&2
    done
    echo "Resolve the index/object failure and retry; repository hooks must not be bypassed." >&2
    exit 1
fi

if [ "${bad_paths[0]+present}" = "present" ]; then
    cat >&2 <<EOF
ERROR: Banned credential / secret file(s) staged. Commit aborted.

  AGENTS.md prohibits committing .env, *.key, *.pem, secrets/, etc.
  See "Protected boundaries" in the agent contract.

Staged files matching the banned pattern:
EOF
    for p in "${bad_paths[@]}"; do
        printf '  - %s\n' "$p" >&2
    done
    cat >&2 <<'EOF'

To remediate:
  git restore --staged <path>      # unstage a file you did not intend to add
  git rm --cached <path>           # untrack a tracked file (then add to .gitignore)
  # If the path is genuinely required, move it OUTSIDE the repo and load
  # via an environment loader, never commit it.

Fix the staged set and retry the commit; repository hooks must not be bypassed.
EOF
    exit 1
fi

if [ "${big_files[0]+present}" = "present" ]; then
    cat >&2 <<'EOF'
ERROR: File(s) larger than 512 KiB staged. Commit aborted.

  Meta-repo commits are expected to be small (text-only). A 512 KiB+ file
  is almost certainly a build artefact, dataset, or accidental binary.
  This repository-local native hook enforces the 512 KiB threshold before
  commit. Its result is local evidence, not a claim that CI repeats the gate.
EOF
    for f in "${big_files[@]}"; do
        printf '  - %s\n' "$f" >&2
    done
    cat >&2 <<'EOF'

To remediate:
  echo "<pattern>" >> .gitignore      # if the path should never be tracked
  git restore --staged <path>         # if you did not intend to add it
EOF
    exit 1
fi

# Commit-signature validation is owned by the separate native pre-push hook in
# .githooks/pre-push and is not duplicated here. Repository policy
# requires contributors to repair hook failures and retry rather than
# bypassing either check.

printf '%s\n' "Pre-commit staged-content check passed."
exit 0
