# HomericIntelligence deployment environment
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# This file provides placeholders only. Select an approved deployment route,
# transport identity, and network boundary before using a remote endpoint.

# ── Service URLs ────────────────────────────────────────────────
# Agamemnon API endpoint. Authentication is required for state-changing calls.
AGAMEMNON_URL=http://localhost:8080

# NATS client endpoint. Use the identity and TLS material required by the
# selected deployment; do not expose an unauthenticated listener.
NATS_URL="tls://<authorized-nats-host>:4222"

# Live legacy myrmidon launchers require one explicit host-wide runtime
# identity. Set this to the effective decimal UID of the service account (for
# example, export HOMERIC_LEGACY_SERVICE_UID="$(id -u)"). Leave the placeholder
# empty until an operator has selected that account. Dry-run recipes do not use
# this identity.
HOMERIC_LEGACY_SERVICE_UID=""

# Leaf authentication: provision independent nonempty passwords on the hub.
# On each approved leaf, provide full URLs using the matching user and password.
# URL-encode password characters; keep these values in deployment secrets, not Git.
# Example shape: nats+tls://leaf-hermes:<encoded-password>@<approved-hub>:7422
NATS_LEAF_HERMES_PASSWORD=""
NATS_LEAF_AGENTS_PASSWORD=""
NATS_LEAF_KEYSTONE_PASSWORD=""
NATS_LEAF_TELEMACHY_PASSWORD=""
NATS_LEAF_HERMES_URL=""
NATS_LEAF_AGENTS_URL=""
NATS_LEAF_KEYSTONE_URL=""
NATS_LEAF_TELEMACHY_URL=""

# Primary Nomad server address (rendered into client.hcl by the explicit,
# approved `just render-nomad-configs <new-output-directory>` operation).
NOMAD_SERVER_IP="<authorized-nomad-server-address>"

# This host's approved Nomad advertise address (rendered into server.hcl).
NOMAD_ADVERTISE_ADDR="<authorized-nomad-advertise-address>"
